{% comment %}
  POST reference endpoint. It marks a challenge verified but never returns a
  person or alias identifier to the browser. SQL is query-only; workflow state
  changes use Rock's ModifyWorkflow command.
{% endcomment %}
{% assign workflowTypeGuid = ConfigurationRigging.verificationWorkflowTypeGuid | Default:'' | Trim %}
{% assign intendedAction = ConfigurationRigging.intendedAction | Default:'' | Trim %}
{% assign maxAttempts = ConfigurationRigging.maxAttempts | Default:5 | AsInteger %}
{% assign verificationSession = Form.verificationSession | Trim %}
{% assign verificationCode = Form.verificationCode | Trim %}
{% assign isVerified = false %}

{% if workflowTypeGuid != '' and intendedAction != '' and verificationSession != '' and verificationCode != '' %}
{% sql return:'verificationState' sessionGuid:'{{ verificationSession }}' code:'{{ verificationCode }}' actionKey:'{{ intendedAction }}' workflowTypeGuid:'{{ workflowTypeGuid }}' maxAttempts:'{{ maxAttempts }}' %}
DECLARE @SessionGuidInput nvarchar(50) = @sessionGuid;
DECLARE @CodeInput nvarchar(20) = LTRIM(RTRIM(@code));
DECLARE @ActionKeyInput nvarchar(100) = @actionKey;
DECLARE @WorkflowTypeGuidInput uniqueidentifier = TRY_CONVERT(uniqueidentifier, @workflowTypeGuid);
DECLARE @MaxAttemptsInput int = CASE WHEN TRY_CONVERT(int, @maxAttempts) BETWEEN 1 AND 10 THEN TRY_CONVERT(int, @maxAttempts) ELSE 5 END;
DECLARE @WorkflowEntityTypeId int = (SELECT TOP 1 Id FROM EntityType WHERE [Name] = 'Rock.Model.Workflow');
DECLARE @ExpectedHash varchar(64) = CONVERT(varchar(64), HASHBYTES('SHA2_256', @CodeInput + ':' + @SessionGuidInput), 2);

SELECT TOP 1
    w.Id AS WorkflowId,
    TRY_CONVERT(int, ISNULL(attempts.Value, '0')) AS Attempts,
    CASE
        WHEN ISNULL(verified.Value, 'False') <> 'True'
         AND ISNULL(consumed.Value, '') = ''
         AND TRY_CONVERT(datetime, expiresAt.Value) >= GETDATE()
         AND TRY_CONVERT(int, ISNULL(attempts.Value, '0')) < @MaxAttemptsInput
         AND UPPER(ISNULL(codeHash.Value, '')) = UPPER(@ExpectedHash)
        THEN 1 ELSE 0
    END AS IsValid
FROM Workflow w
INNER JOIN WorkflowType wt ON wt.Id = w.WorkflowTypeId
INNER JOIN AttributeValue sessionValue ON sessionValue.EntityId = w.Id
INNER JOIN Attribute sessionAttribute ON sessionAttribute.Id = sessionValue.AttributeId
INNER JOIN AttributeValue actionValue ON actionValue.EntityId = w.Id
INNER JOIN Attribute actionAttribute ON actionAttribute.Id = actionValue.AttributeId
LEFT JOIN AttributeValue attempts ON attempts.EntityId = w.Id
    AND attempts.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'Attempts')
LEFT JOIN AttributeValue verified ON verified.EntityId = w.Id
    AND verified.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'Verified')
LEFT JOIN AttributeValue consumed ON consumed.EntityId = w.Id
    AND consumed.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'ConsumedAt')
LEFT JOIN AttributeValue expiresAt ON expiresAt.EntityId = w.Id
    AND expiresAt.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'ExpiresAt')
LEFT JOIN AttributeValue codeHash ON codeHash.EntityId = w.Id
    AND codeHash.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'CodeHash')
WHERE wt.[Guid] = @WorkflowTypeGuidInput
  AND sessionAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND sessionAttribute.[Key] = 'SessionGuid'
  AND sessionValue.Value = @SessionGuidInput
  AND actionAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND actionAttribute.[Key] = 'IntendedAction'
  AND actionValue.Value = @ActionKeyInput;
{% endsql %}

{% assign verificationRow = verificationState | First %}
{% assign workflowId = verificationRow.WorkflowId | Default:0 | AsInteger %}
{% assign attempts = verificationRow.Attempts | Default:0 | AsInteger %}
{% assign nextAttempts = attempts | Plus:1 %}
{% assign validValue = verificationRow.IsValid | ToString | Downcase %}
{% assign isValid = false %}
{% if validValue == 'true' or validValue == '1' %}{% assign isValid = true %}{% endif %}

{% if workflowId > 0 %}
  {% if isValid %}
    {% modifyworkflow id:'{{ workflowId }}' securityenabled:'false' %}
      [[ attribute key:'Attempts' ]]{{ nextAttempts }}[[ endattribute ]]
      [[ attribute key:'Verified' ]]True[[ endattribute ]]
    {% endmodifyworkflow %}
    {% if ModifyResult.Success %}{% assign isVerified = true %}{% endif %}
  {% else %}
    {% modifyworkflow id:'{{ workflowId }}' securityenabled:'false' %}
      [[ attribute key:'Attempts' ]]{{ nextAttempts }}[[ endattribute ]]
    {% endmodifyworkflow %}
  {% endif %}
{% endif %}
{% endif %}

{% httpresponse %}
[[ header key:'Content-Type' ]]text/html; charset=utf-8[[ endheader ]]
[[ header key:'Cache-Control' ]]no-store[[ endheader ]]
{% endhttpresponse %}
{% if isVerified %}
<div class="alert alert-success" role="status">Verification complete. Continue with the form.</div>
<input type="hidden" name="verificationSession" value="{{ verificationSession | Escape }}">
{% else %}
<div class="alert alert-warning" role="alert">The code could not be verified. Request a new code or continue without verification.</div>
{% endif %}
