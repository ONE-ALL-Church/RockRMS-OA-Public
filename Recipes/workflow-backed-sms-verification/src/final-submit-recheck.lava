{% comment %}
  Place immediately before the protected final action. SQL is query-only and
  workflow state changes use ModifyWorkflow. The protected action must enforce
  idempotency with protectedActionIdempotencyKey because ModifyWorkflow is not
  an atomic compare-and-set operation.
{% endcomment %}
{% assign workflowTypeGuid = ConfigurationRigging.verificationWorkflowTypeGuid | Default:'' | Trim %}
{% assign intendedAction = ConfigurationRigging.intendedAction | Default:'' | Trim %}
{% assign verificationSession = Form.verificationSession | Trim %}
{% assign verifiedAliasGuid = '' %}
{% assign protectedActionIdempotencyKey = '' %}

{% if workflowTypeGuid != '' and intendedAction != '' and verificationSession != '' %}
{% sql return:'challengeState' sessionGuid:'{{ verificationSession }}' actionKey:'{{ intendedAction }}' workflowTypeGuid:'{{ workflowTypeGuid }}' %}
DECLARE @SessionGuidInput nvarchar(50) = @sessionGuid;
DECLARE @ActionKeyInput nvarchar(100) = @actionKey;
DECLARE @WorkflowTypeGuidInput uniqueidentifier = TRY_CONVERT(uniqueidentifier, @workflowTypeGuid);
DECLARE @WorkflowEntityTypeId int = (SELECT TOP 1 Id FROM EntityType WHERE [Name] = 'Rock.Model.Workflow');

SELECT TOP 1
    w.Id AS WorkflowId,
    CAST(pa.[Guid] AS nvarchar(50)) AS AliasGuid
FROM Workflow w
INNER JOIN WorkflowType wt ON wt.Id = w.WorkflowTypeId
INNER JOIN AttributeValue sessionValue ON sessionValue.EntityId = w.Id
INNER JOIN Attribute sessionAttribute ON sessionAttribute.Id = sessionValue.AttributeId
INNER JOIN AttributeValue actionValue ON actionValue.EntityId = w.Id
INNER JOIN Attribute actionAttribute ON actionAttribute.Id = actionValue.AttributeId
INNER JOIN AttributeValue candidateValue ON candidateValue.EntityId = w.Id
INNER JOIN Attribute candidateAttribute ON candidateAttribute.Id = candidateValue.AttributeId
INNER JOIN AttributeValue verifiedValue ON verifiedValue.EntityId = w.Id
INNER JOIN Attribute verifiedAttribute ON verifiedAttribute.Id = verifiedValue.AttributeId
INNER JOIN AttributeValue expiresValue ON expiresValue.EntityId = w.Id
INNER JOIN Attribute expiresAttribute ON expiresAttribute.Id = expiresValue.AttributeId
LEFT JOIN AttributeValue consumedValue ON consumedValue.EntityId = w.Id
    AND consumedValue.AttributeId = (SELECT TOP 1 Id FROM Attribute WHERE EntityTypeId = @WorkflowEntityTypeId AND EntityTypeQualifierColumn = 'WorkflowTypeId' AND EntityTypeQualifierValue = CONVERT(nvarchar(20), w.WorkflowTypeId) AND [Key] = 'ConsumedAt')
INNER JOIN PersonAlias pa ON pa.[Guid] = TRY_CONVERT(uniqueidentifier, candidateValue.Value)
INNER JOIN Person p ON p.Id = pa.PersonId
WHERE wt.[Guid] = @WorkflowTypeGuidInput
  AND sessionAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND sessionAttribute.[Key] = 'SessionGuid'
  AND sessionValue.Value = @SessionGuidInput
  AND actionAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND actionAttribute.[Key] = 'IntendedAction'
  AND actionValue.Value = @ActionKeyInput
  AND candidateAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND candidateAttribute.[Key] = 'Candidate'
  AND verifiedAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND verifiedAttribute.[Key] = 'Verified'
  AND verifiedValue.Value = 'True'
  AND expiresAttribute.EntityTypeId = @WorkflowEntityTypeId
  AND expiresAttribute.[Key] = 'ExpiresAt'
  AND TRY_CONVERT(datetime, expiresValue.Value) >= GETDATE()
  AND ISNULL(consumedValue.Value, '') = ''
  AND p.PrimaryAliasId = pa.Id
  AND ISNULL(p.IsDeceased, 0) = 0;
{% endsql %}

{% assign challengeRow = challengeState | First %}
{% assign workflowId = challengeRow.WorkflowId | Default:0 | AsInteger %}
{% assign candidateAliasGuid = challengeRow.AliasGuid | Default:'' | Trim %}
{% if workflowId > 0 and candidateAliasGuid != '' %}
  {% assign consumedAt = 'Now' | Date:'yyyy-MM-dd HH:mm:ss' %}
  {% modifyworkflow id:'{{ workflowId }}' securityenabled:'false' %}
    [[ attribute key:'ConsumedAt' ]]{{ consumedAt }}[[ endattribute ]]
  {% endmodifyworkflow %}
  {% if ModifyResult.Success %}
    {% assign verifiedAliasGuid = candidateAliasGuid %}
    {% assign protectedActionIdempotencyKey = intendedAction | Append:':' | Append:verificationSession %}
  {% endif %}
{% endif %}
{% endif %}

{% if verifiedAliasGuid == '' %}
  <div class="alert alert-warning" role="alert">Verification expired or could not be confirmed. Request a new code before continuing.</div>
{% else %}
  {% comment %}
    Perform the intended server-side action here using verifiedAliasGuid.
    The action must reject or return the prior result when it receives the same
    protectedActionIdempotencyKey again. Do not accept a person or alias
    identifier from the browser.
  {% endcomment %}
{% endif %}
